# Copie para .env e preencha

# Viking — assistente Gemini (src/lifeos/assistant/agent.py, migrado de calendar-bot/)
GEMINI_API_KEY=

# Viking — Google Calendar OAuth (arquivos; caminhos configuráveis, padrão em secrets/).
# Caminho relativo aqui ancora na raiz do repo, não no diretório de onde `viking` foi chamado.
VIKING_GOOGLE_CREDENTIALS_PATH=./secrets/google_credentials.json
VIKING_GOOGLE_TOKEN_PATH=./secrets/google_token.json

# Viking — automação de navegador (executor Jev + Browser Harness)
# Pasta do clone do jev-ultrafast. No Mac ele vive FORA deste repo, ex.:
#   VIKING_JEV_DIR=/Users/luanabreno/jev-ultrafast
# As chaves do Jev (OPENROUTER_API_KEY, TEXT_MODEL_*) ficam no .env DELE, não aqui.
VIKING_JEV_DIR=./jev-ultrafast
#VIKING_JEV_ENV_FILE=./jev-ultrafast/.env
#VIKING_UV_BIN=uv
#VIKING_BROWSER_TIMEOUT_S=180
#VIKING_BROWSER_MAX_ACOES=30
# Banco e e-mail são bloqueados por padrão no navegador (lista em src/lifeos/config.py). Separe
# domínios por vírgula; um domínio bloqueia também os subdomínios dele. LIBERADOS remove a
# entrada EXATA da lista (liberar www.itau.com.br não libera itau.com.br).
#VIKING_BROWSER_BLOQUEADOS=meubanco.com.br,outro.com
#VIKING_BROWSER_LIBERADOS=mail.google.com

# Viking — fuso civil (resolve "amanhã" e monta janelas de dia no calendário, e o instante de
# lembretes com prazo). Zona IANA, ex.: America/Sao_Paulo. Sem isto, usa o offset fixo da máquina
# (não acompanha horário de verão).
#VIKING_TIMEZONE=America/Sao_Paulo

# Viking — lembretes (SQLite local). Caminho relativo ancora na raiz do repo.
#VIKING_DB_PATH=./data/viking.db

# Viking — contabilidade de custo do Gemini (US$ por 1M tokens; confira no painel do provedor).
#VIKING_PRECO_GEMINI_ENTRADA=0.30
#VIKING_PRECO_GEMINI_SAIDA=2.50
